{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Env",
  "x-config-id": "env",
  "x-default-filename": "env.yml",
  "type": "object",
  "properties": {
    "variables": {
      "type": "array",
      "title": "Variables",
      "minItems": 1,
      "x-item-label": "variable",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "minLength": 1,
            "x-placeholder": "API_URL"
          },
          "value": {
            "type": "string",
            "title": "Value",
            "minLength": 1,
            "x-placeholder": "https://api.example.com"
          },
          "secret": {
            "type": "boolean",
            "title": "Secret"
          }
        },
        "required": ["name", "value", "secret"]
      }
    }
  },
  "required": ["variables"]
}
