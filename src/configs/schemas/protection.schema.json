{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protection",
  "x-config-id": "protection",
  "x-default-filename": "protection.yml",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "title": "Branch",
      "minLength": 1,
      "x-placeholder": "main"
    },
    "requiredApprovingReviews": {
      "type": "integer",
      "title": "Required approving reviews",
      "minimum": 1,
      "maximum": 6
    },
    "requiredStatusChecks": {
      "type": "array",
      "title": "Required status checks",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "x-placeholder": "ci/build"
      }
    },
    "enforceAdmins": {
      "type": "boolean",
      "title": "Enforce for admins"
    }
  },
  "required": ["branch", "requiredApprovingReviews", "requiredStatusChecks", "enforceAdmins"]
}
