{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wdalmeida/yaml-config-generator-validator/onboarding.meta.schema.json",
  "title": "Onboarding checklist file",
  "description": "The shape of every src/onboarding/*.onboarding.json file. Referenced from each file's $schema key so editors offer autocomplete; enforced in CI by scripts/validate-json-schemas.mjs, and again at runtime by the Zod schema in src/onboarding/types.ts.",
  "type": "object",
  "required": ["title", "x-onboarding-id", "x-default-filename", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "description": "Pill label." },
    "x-onboarding-id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "description": "Stable id. Also the localStorage key suffix - changing it orphans saved progress."
    },
    "x-default-filename": {
      "type": "string",
      "minLength": 1,
      "description": "Fixed filename this checklist is committed under."
    },
    "intro": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "description": "Stable id, written into the checklist YAML. Renaming it orphans saved progress for this step."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Imperative mood: 'Commit config.yaml', not 'Committing' or 'You should commit'."
          },
          "detail": { "type": "string", "minLength": 1 },
          "optional": {
            "type": "boolean",
            "description": "An optional step doesn't have to be ticked for the pill to go green."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["docs", "link", "jira", "command", "config"] },
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https?://" },
                "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
                "command": { "type": "string", "minLength": 1 },
                "configId": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                { "if": { "properties": { "type": { "const": "docs" } } }, "then": { "required": ["url"] } },
                { "if": { "properties": { "type": { "const": "link" } } }, "then": { "required": ["url", "label"] } },
                { "if": { "properties": { "type": { "const": "jira" } } }, "then": { "required": ["key"] } },
                { "if": { "properties": { "type": { "const": "command" } } }, "then": { "required": ["command"] } },
                { "if": { "properties": { "type": { "const": "config" } } }, "then": { "required": ["configId"] } }
              ]
            }
          }
        }
      }
    }
  }
}
