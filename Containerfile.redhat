# The same site as `Containerfile`, built and served entirely on Red Hat images.
#
# Why a second file rather than a replacement: plenty of places can't run an
# Alpine/musl image at all - a RHEL lineage is a procurement or compliance
# requirement (FIPS-validated crypto, an entitled base, "must be a Red Hat image"
# policy), and the Red Hat Hardened Images built by Project Hummingbird
# (https://hummingbird-project.io) are minimal, distroless, and updated on an
# automated near-zero-CVE cadence. Neither file is the "real" one; they produce the
# same site from the same `container/nginx.conf`, and CI builds, smoke-tests and
# scans both. Pick whichever your platform team will accept.
#
# Both stages come from registry.access.redhat.com/hi/ - public, no subscription and
# no `registry.redhat.io` login needed, redistributable under the UBI EULA
# (`distribution-scope=public`).
#
# Like `Containerfile`, this sticks to plain OCI-compatible instructions - no
# `# syntax=` directive, no `RUN --mount` cache mounts, no `HEALTHCHECK` - so
# `buildah bud`, `podman build` and `docker build` all produce the same image.
#
# Base images are pinned by digest (the tag is kept alongside it only so the pin is
# readable, and so Renovate can bump both together), matching how every `uses:` in
# .github/workflows is pinned - a tag is mutable, a digest is not. The digests here
# are the multi-arch index digests, so they resolve on amd64 and arm64 alike.

# The `-builder` tag is the variant that ships bash, dnf and npm; the plain
# `hi/nodejs` tag is distroless (a `node` binary and nothing to drive it with), which
# is right for running an app and useless for building one.
FROM registry.access.redhat.com/hi/nodejs:24-builder@sha256:3c4021888629470457c5ba2f32cf31be24915671b3418af6c03ce1bcc7c71e3b AS build

# No `mkdir`/`chown` dance here, unlike Containerfile: the Hummingbird image already
# ships /app owned by the non-root user it defaults to, so the whole build stage runs
# unprivileged without ever declaring `USER 0` to prepare a directory.
WORKDIR /app

# 65532 is the UID every Hummingbird image defaults to; group 0 is the OpenShift
# convention (an arbitrary assigned UID still lands in the root group). Numeric so the
# host needs no name lookup (hadolint DL3066) and so it survives a base image rename.
COPY --chown=65532:0 package.json package-lock.json ./

# --ignore-scripts: no dependency lifecycle script runs at install time, so a
# compromised package cannot execute code during the build. Nothing here needs one -
# esbuild/rollup ship prebuilt per-platform binaries as optional dependencies.
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY --chown=65532:0 . .

RUN npm run build


FROM registry.access.redhat.com/hi/nginx@sha256:4a629d3d44510edb18f04bf54b3d24dc6413b8a88bb5673365c6a4382cd527e5 AS runtime

# Supplied by the build (see docs/container.md); left empty when building by hand.
ARG IMAGE_CREATED=""
ARG IMAGE_REVISION=""
ARG IMAGE_VERSION=""

LABEL org.opencontainers.image.title="yaml-config-generator-validator" \
      org.opencontainers.image.description="Static site for filling out and validating the YAML config files our software requires (Red Hat Hardened Images build)" \
      org.opencontainers.image.source="https://github.com/wdalmeida/yaml-config-generator-validator" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.created="${IMAGE_CREATED}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

# Byte-for-byte the same server config the Alpine image uses. hi/nginx's own
# /etc/nginx/nginx.conf includes conf.d/*.conf and already listens on 8080, logs to
# /dev/stdout and /dev/stderr (both are symlinks in the base) and keeps its pid file in
# /tmp - so the read-only rootfs story is identical without a single edit.
COPY container/nginx.conf /etc/nginx/conf.d/default.conf

# The one thing this image needs that the Alpine one does not - see the file's own
# comment for the emerg it prevents.
COPY container/redhat-temp-paths.conf /etc/nginx/conf.d/00-temp-paths.conf

# --chown=0:0 is deliberate and is the one place this differs from Containerfile's
# plain COPY: the files arrive from the build stage owned by 65532, which is also the
# UID nginx runs as here, so without this the running container could rewrite its own
# web root. nginx only ever reads it.
COPY --from=build --chown=0:0 /app/dist /usr/share/nginx/html

# Already the base image's default; restated numerically so it survives a base image
# change and so Kubernetes' runAsNonRoot check can verify it without resolving a name.
#
# Group 0, not 65532, and that matters: the Hummingbird images follow the OpenShift
# convention where an arbitrary assigned UID still lands in the root group, and several
# of nginx's own directories are group-0 writable rather than owned by 65532. Declaring
# `USER 65532:65532` here builds an image that cannot start.
USER 65532:0

EXPOSE 8080

# nginx treats SIGQUIT as "finish in-flight requests, then exit"; SIGTERM kills them.
# Also already the base image's default - restated so a base change can't quietly
# take it away.
STOPSIGNAL SIGQUIT

# No HEALTHCHECK: it is a Docker-format extension with no field in the OCI image spec,
# and buildah drops it unless the image is built with `--format docker`. Probe the
# /healthz endpoint from the orchestrator instead (see docs/container.md).

# No CMD/ENTRYPOINT either, and that is not an oversight: hi/nginx already declares
# ENTRYPOINT ["/usr/sbin/nginx"] with CMD ["-c", "/etc/nginx/nginx.conf", "-e",
# "/dev/stderr", "-g", "daemon off;"]. Restating Containerfile's
# `CMD ["nginx", "-g", "daemon off;"]` here would be appended to that entrypoint and
# the container would fail to start.
