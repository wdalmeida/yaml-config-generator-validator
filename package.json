{
  "name": "yaml-config-generator-validator",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:schemas": "node scripts/validate-json-schemas.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:links": "./scripts/check-markdown-links.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && npx gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-cli2-formatter-sarif": "^0.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
