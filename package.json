{
  "name": "yaml-config-generator-validator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:schemas": "node scripts/validate-json-schemas.mjs",
    "lint:ci-gate": "node scripts/check-ci-ok-covers-every-job.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:links": "./scripts/check-markdown-links.sh",
    "lint:links:external": "./scripts/check-markdown-links.sh .markdown-link-check.external.json",
    "lint:size": "size-limit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && npx gh-pages -d dist"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-cli2-formatter-sarif": "^0.0.4",
    "oxlint": "^1.75.0",
    "size-limit": "^13.0.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "xmlbuilder2": {
      "js-yaml": "^5.4.1"
    },
    "markdownlint-cli2": {
      "smol-toml": "^1.8.0"
    },
    "ajv": {
      "fast-uri": "^3.1.6"
    }
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
