{
  "config": {
    "default": true,
    // Long descriptive lines are the deliberate style in these docs (see CLAUDE.md,
    // docs/adding-a-schema.md) - not a formatting mistake to flag.
    "MD013": false,
    // Pedantic pipe-spacing in tables; doesn't affect rendering, not worth enforcing.
    "MD060": false
  },
  "globs": ["**/*.md"],
  // .ci-tools/ holds the pinned tool downloads (`just install-pinned`), which since
  // helm-unittest includes a plugin directory with the plugin's own README in it. Gitignored,
  // so CI never sees it - this keeps `just lint:md` from failing on someone else's markdown.
  "ignores": ["**/node_modules/**", "**/.ci-tools/**"],
  "outputFormatters": [["markdownlint-cli2-formatter-sarif", { "name": "markdownlint-results.sarif" }]]
}
